{
    "$schema": "https://turborepo.dev/schema.json",
    "ui": "stream",
    "tasks": {
        "build": {
            "dependsOn": [
                "^build"
            ],
            "outputs": [
                "dist/**"
            ]
        },
        "dev": {
            "dependsOn": [
                "^build"
            ],
            "cache": false,
            "persistent": true
        },
        "test": {
            "dependsOn": [
                "^build"
            ],
            "outputs": []
        },
        "start": {
            "dependsOn": [
                "build"
            ],
            "cache": false,
            "persistent": true
        }
    }
}